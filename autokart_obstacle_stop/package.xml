<?xml version="1.0"?>
<package format="3">
  <name>autokart_obstacle_stop</name>
  <version>0.1.0</version>
  <description>Fail-closed forward-cone stop guard between controller and VCU bridge.</description>
  <maintainer email="harrishkesavan@gmail.com">AutoKart</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>autokart_msgs</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>

