<?xml version="1.0"?>
<package format="3">
  <name>autokart_dashboard_gateway</name>
  <version>0.1.0</version>
  <description>Read-only ROS 2 to Mission Control WebSocket gateway.</description>
  <maintainer email="simulation@example.invalid">AutoKart Sim Studio</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>autokart_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
