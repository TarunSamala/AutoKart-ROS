Visualization Manager:
  Fixed Frame: map
  Displays:
    - {Class: rviz_default_plugins/RobotModel, Name: Kart, Enabled: true, Description Topic: /robot_description}
    - {Class: rviz_default_plugins/Polygon, Name: Safety Envelope, Enabled: true, Topic: /safety/envelope_polygon}
    - {Class: rviz_default_plugins/MarkerArray, Name: Fault Markers, Enabled: true, Topic: /diagnostics/fault_markers}
    - {Class: rviz_default_plugins/MarkerArray, Name: EStop, Enabled: true, Topic: /safety/estop_marker}
