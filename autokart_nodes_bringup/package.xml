<?xml version="1.0"?>
<package format="3">
  <name>autokart_nodes_bringup</name>
  <version>0.1.0</version>
  <description>Launch-only integration package for the autokart_ros_nodes library: brings up all 12 node packages together (synthetic/standalone backends, every output inhibited, DISARMED), plus the two small typed-topic adapters needed to actually connect node 10's safety_armed decision and node 06's map geometry to the nodes that read them.</description>
  <maintainer email="harrishkesavan@gmail.com">AutoKart</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>autokart_msgs</exec_depend>
  <exec_depend>autokart_hp60c</exec_depend>
  <exec_depend>autokart_perception_adapter</exec_depend>
  <exec_depend>autokart_imu</exec_depend>
  <exec_depend>autokart_vcu_bridge</exec_depend>
  <exec_depend>autokart_odometry</exec_depend>
  <exec_depend>autokart_mapping</exec_depend>
  <exec_depend>autokart_mission</exec_depend>
  <exec_depend>autokart_planner</exec_depend>
  <exec_depend>autokart_controller</exec_depend>
  <exec_depend>autokart_safety</exec_depend>
  <exec_depend>autokart_dashboard_gateway</exec_depend>
  <exec_depend>autokart_system_monitor</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>
  <test_depend>launch_testing</test_depend>
  <test_depend>launch_testing_ros</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
