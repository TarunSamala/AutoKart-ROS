  <version>0.1.0</version>
  <description>Optional ROS 2 transport adapter for the headless kart simulator.</description>
  <maintainer email="unconfigured@example.invalid">Kart Simulator</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>rosidl_default_generators</build_depend>
