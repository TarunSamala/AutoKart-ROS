<?xml version="1.0"?>
<sdf version="1.7">
  <world name="autokart_mixed_surface">
    <gravity>0 0 -9.80665</gravity><physics name="deterministic" type="ode"><max_step_size>.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <scene><ambient>.30 .34 .38 1</ambient><background>.28 .38 .52 1</background><shadows>true</shadows></scene>
    <light name="overcast" type="directional"><cast_shadows>true</cast_shadows><diffuse>.62 .66 .72 1</diffuse><direction>-.2 .1 -1</direction></light>
    <model name="ground"><static>true</static><link name="ground"><collision name="ground"><geometry><plane><normal>0 0 1</normal><size>90 60</size></plane></geometry></collision><visual name="grass"><geometry><plane><normal>0 0 1</normal><size>90 60</size></plane></geometry><material><ambient>.05 .22 .04 1</ambient></material></visual></link></model>
    <model name="dry_lane"><static>true</static><pose>0 2.5 .006 0 0 0</pose><link name="dry"><collision name="dry_collision"><geometry><box><size>60 5 .01</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>.95</mu2></ode></friction></surface></collision><visual name="dry_visual"><geometry><box><size>60 5 .01</size></box></geometry><material><ambient>.13 .13 .14 1</ambient></material></visual></link></model>
    <model name="wet_lane"><static>true</static><pose>0 -2.5 .006 0 0 0</pose><link name="wet"><collision name="wet_collision"><geometry><box><size>60 5 .01</size></box></geometry><surface><friction><ode><mu>.55</mu><mu2>.50</mu2></ode></friction></surface></collision><visual name="wet_visual"><geometry><box><size>60 5 .01</size></box></geometry><material><ambient>.05 .08 .12 1</ambient><diffuse>.08 .12 .18 1</diffuse><specular>.6 .6 .7 1</specular></material></visual></link></model>
    <model name="oil_patch"><static>true</static><pose>8 0 .014 0 0 0</pose><link name="oil"><visual name="oil"><geometry><cylinder><radius>1.8</radius><length>.012</length></cylinder></geometry><material><ambient>.03 .02 .05 .8</ambient><specular>.8 .7 .9 1</specular></material></visual></link></model>
  </world>
</sdf>
