    <model name="blue_08"><static>true</static><pose>5.66 -5.66 .28 0 0 0</pose><link name="cone"><collision name="c"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry><material><ambient>.02 .12 .95 1</ambient></material></visual></link></model>
    <model name="yellow_08"><static>true</static><pose>8.49 -8.49 .28 0 0 0</pose><link name="cone"><collision name="c"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry><material><ambient>.95 .78 .02 1</ambient></material></visual></link></model>

    <include><uri>model://autokart</uri><name>autokart</name><pose>10 0 0 0 0 1.96349540849</pose></include>
  </world>
</sdf>
