<?xml version="1.0"?>
<sdf version="1.7">
  <!-- SIMULATION USE ONLY — deterministic follower acceptance world. -->
  <world name="autokart_gazebo_follower">
    <gravity>0 0 -9.80665</gravity>
    <physics name="follower_clock" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene><ambient>.48 .50 .52 1</ambient><background>.42 .64 .88 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><diffuse>.96 .92 .84 1</diffuse><direction>-.45 .20 -1</direction></light>
    <model name="ground"><static>true</static><link name="ground"><collision name="ground"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry></collision><visual name="asphalt"><geometry><plane><normal>0 0 1</normal><size>80 80</size></plane></geometry><material><ambient>.10 .10 .11 1</ambient><diffuse>.17 .17 .18 1</diffuse></material></visual></link></model>
    <model name="grass_infield"><static>true</static><pose>0 0 .006 0 0 0</pose><link name="grass"><visual name="grass"><geometry><cylinder><radius>7.7</radius><length>.01</length></cylinder></geometry><material><ambient>.06 .28 .04 1</ambient><diffuse>.08 .38 .05 1</diffuse></material></visual></link></model>
    <model name="timing_line"><static>true</static><pose>9.2 0 .014 0 0 0</pose><link name="line"><visual name="line"><geometry><box><size>2.8 .18 .018</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material></visual></link></model>

    <!-- Camera calibration target: alternating panels, visible from the start sector. -->
    <model name="calibration_target"><static>true</static><pose>7.0 6.8 1.0 0 0 1.96</pose><link name="target"><collision name="back_collision"><geometry><box><size>.08 1.2 1.2</size></box></geometry></collision><visual name="back_visual"><geometry><box><size>.08 1.2 1.2</size></box></geometry><material><ambient>.9 .9 .9 1</ambient><diffuse>.9 .9 .9 1</diffuse></material></visual><visual name="black_1"><pose>-.05 .3 .3 0 0 0</pose><geometry><box><size>.02 .55 .55</size></box></geometry><material><ambient>.01 .01 .01 1</ambient></material></visual><visual name="black_2"><pose>-.05 -.3 -.3 0 0 0</pose><geometry><box><size>.02 .55 .55</size></box></geometry><material><ambient>.01 .01 .01 1</ambient></material></visual></link></model>

    <!-- Semantic-looking boundary markers also provide camera and ray returns. -->
    <model name="blue_01"><static>true</static><pose>8.0 0 .28 0 0 0</pose><link name="cone"><collision name="c"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry><material><ambient>.02 .12 .95 1</ambient><diffuse>.02 .18 1 1</diffuse></material></visual></link></model>
    <model name="yellow_01"><static>true</static><pose>12.0 0 .28 0 0 0</pose><link name="cone"><collision name="c"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry><material><ambient>.95 .78 .02 1</ambient><diffuse>1 .88 .02 1</diffuse></material></visual></link></model>
    <model name="blue_02"><static>true</static><pose>5.66 5.66 .28 0 0 0</pose><link name="cone"><collision name="c"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry><material><ambient>.02 .12 .95 1</ambient></material></visual></link></model>
    <model name="yellow_02"><static>true</static><pose>8.49 8.49 .28 0 0 0</pose><link name="cone"><collision name="c"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry></collision><visual name="v"><geometry><cylinder><radius>.16</radius><length>.56</length></cylinder></geometry><material><ambient>.95 .78 .02 1</ambient></material></visual></link></model>
