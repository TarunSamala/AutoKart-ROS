{
  "name": "live-delaunay-kart-lab",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "check": "npm run test && npm run build",
    "dev:dashboard": "vite --config vite.dashboard.config.ts",
    "dev:lab": "vite --config vite.lab.config.ts",
    "build:dashboard": "tsc -b && vite build --config vite.dashboard.config.ts",
    "build:lab": "tsc -b && vite build --config vite.lab.config.ts",
    "preview:dashboard": "vite preview --config vite.dashboard.config.ts",
    "preview:lab": "vite preview --config vite.lab.config.ts",
    "build:apps": "npm run build:dashboard && npm run build:lab"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@vitejs/plugin-react": "latest",
    "delaunator": "^5.0.1",
    "react": "latest",
    "react-dom": "latest",
    "three": "^0.186.1",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.186.0",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
