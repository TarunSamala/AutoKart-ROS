<?xml version="1.0"?>
<sdf version="1.7">
  <world name="autokart_acceleration">
    <gravity>0 0 -9.80665</gravity><physics name="deterministic" type="ode"><max_step_size>.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <scene><ambient>.55 .55 .52 1</ambient><background>.45 .68 .92 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><diffuse>1 .94 .82 1</diffuse><direction>-.3 .1 -1</direction></light>
    <model name="ground"><static>true</static><link name="ground"><collision name="ground"><geometry><plane><normal>0 0 1</normal><size>160 50</size></plane></geometry></collision><visual name="grass"><geometry><plane><normal>0 0 1</normal><size>160 50</size></plane></geometry><material><ambient>.08 .32 .05 1</ambient><diffuse>.1 .42 .07 1</diffuse></material></visual></link></model>
    <model name="course"><static>true</static><pose>50 0 .006 0 0 0</pose><link name="asphalt"><collision name="asphalt_collision"><geometry><box><size>125 5 .01</size></box></geometry><surface><friction><ode><mu>1</mu><mu2>.95</mu2></ode></friction></surface></collision><visual name="asphalt_visual"><geometry><box><size>125 5 .01</size></box></geometry><material><ambient>.11 .11 .12 1</ambient><diffuse>.18 .18 .19 1</diffuse></material></visual></link></model>
    <model name="start_line"><static>true</static><pose>0 0 .013 0 0 0</pose><link name="line"><visual name="white"><geometry><box><size>.15 5 .015</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual></link></model>
    <model name="finish_line"><static>true</static><pose>75 0 .013 0 0 0</pose><link name="line"><visual name="check"><geometry><box><size>.25 5 .015</size></box></geometry><material><ambient>.95 .55 .05 1</ambient></material></visual></link></model>
    <model name="estop_zone"><static>true</static><pose>90 0 .014 0 0 0</pose><link name="zone"><visual name="red"><geometry><box><size>20 4.8 .016</size></box></geometry><material><ambient>.35 .02 .02 .65</ambient><diffuse>.55 .03 .03 .65</diffuse></material></visual></link></model>
  </world>
</sdf>
