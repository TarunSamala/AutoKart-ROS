<?xml version="1.0"?>
<sdf version="1.7">
  <world name="autokart_empty_test">
    <gravity>0 0 -9.80665</gravity>
    <physics name="deterministic" type="ode"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <scene><ambient>.5 .52 .55 1</ambient><background>.42 .64 .88 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><cast_shadows>true</cast_shadows><pose>0 0 20 0 0 0</pose><diffuse>.95 .90 .82 1</diffuse><direction>-.4 .2 -1</direction></light>
    <model name="ground"><static>true</static><link name="ground">
      <collision name="ground"><geometry><plane><normal>0 0 1</normal><size>80 60</size></plane></geometry><surface><friction><ode><mu>1</mu><mu2>.95</mu2></ode></friction></surface></collision>
      <visual name="grass"><geometry><plane><normal>0 0 1</normal><size>80 60</size></plane></geometry><material><ambient>.07 .30 .05 1</ambient><diffuse>.10 .42 .07 1</diffuse></material></visual>
    </link></model>
    <model name="asphalt_pad"><static>true</static><pose>0 0 .006 0 0 0</pose><link name="pad"><collision name="pad_collision"><geometry><box><size>40 20 .01</size></box></geometry></collision><visual name="pad_visual"><geometry><box><size>40 20 .01</size></box></geometry><material><ambient>.11 .11 .12 1</ambient><diffuse>.17 .17 .18 1</diffuse></material></visual></link></model>
    <model name="spawn_grid_marker"><static>true</static><pose>-15 0 .013 0 0 0</pose><link name="line"><visual name="line"><geometry><box><size>.12 4 .015</size></box></geometry><material><ambient>.95 .95 .95 1</ambient></material></visual></link></model>
  </world>
</sdf>
